{
  "name": "road-runner-studio",
  "private": true,
  "version": "2.8.3",
  "description": "Premium AI image and SVG generation studio",
  "author": "FDTiger777",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "wait-on tcp:3000 && cross-env ELECTRON_RENDERER_URL=http://localhost:3000 electron .",
    "dev:desktop": "concurrently -k \"npm:dev\" \"npm:dev:electron\"",
    "build": "vite build",
    "prepare:desktop-cache": "node scripts/prepare-desktop-build.cjs",
    "build:desktop": "npm run build && npm run prepare:desktop-cache && cross-env ELECTRON_CACHE=.cache/electron ELECTRON_BUILDER_CACHE=.cache/electron-builder electron-builder --win nsis --config.win.signAndEditExecutable=false",
    "build:desktop:dir": "npm run build && npm run prepare:desktop-cache && cross-env ELECTRON_CACHE=.cache/electron ELECTRON_BUILDER_CACHE=.cache/electron-builder electron-builder --win --dir --config.win.signAndEditExecutable=false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.9",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "wait-on": "^8.0.5",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.fdtiger777.roadrunnerstudio",
    "productName": "Road Runner Studio",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JhonSer555",
        "repo": "road_runner_studio_image-svg-generator"
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "legalTrademarks": "FDTiger777",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Road Runner Studio",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    }
  }
}
